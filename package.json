{
  "name": "mangaimart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "bundle-migrations": "node scripts/bundle-migrations.mjs",
    "lint": "eslint .",
    "verify:seo": "npm run build && node scripts/verify-seo.mjs",
