# =============================================================================
# STAGING / TEST environment template.
#
# Copy to `.env.staging` for local testing against the TEST Supabase project:
#     cp .env.staging.example .env.staging     (then fill in the values)
#     npm run dev:staging                       (loads .env.staging + shows the TEST ribbon)
#
# In Vercel, these same values go under the *Preview* environment scope, NOT
# Production. See ENVIRONMENTS.md for the full setup.
#
# Every value here MUST point at the throwaway TEST project — never the prod one.
# =============================================================================

# Marks the build as non-production so the corner "TEST" ribbon shows.
VITE_APP_ENV=staging

# --- TEST Supabase project (a SECOND Supabase project, separate from prod) ---
VITE_SUPABASE_URL=https://your-TEST-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-TEST-anon-key

# Server-only (Vercel Preview scope). SUPABASE_URL falls back to VITE_SUPABASE_URL.
SUPABASE_URL=https://your-TEST-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-TEST-service-role-key

# --- Resend: keep test email off or send to a throwaway inbox ---
RESEND_API_KEY=
EMAIL_FROM=noreply@mangaimart.com
APP_URL=https://staging-your-app.vercel.app

# --- Razorpay: TEST keys only (rzp_test_...). Never live keys on staging. ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-TEST-key-secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-razorpay-TEST-webhook-secret

# --- Optional: a SEPARATE Upstash Redis for staging (don't share prod's) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
